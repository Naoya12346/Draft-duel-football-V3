{
  "expo": {
    "name": "Draft Duel",
    "slug": "draft-duel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "splash": {
      "backgroundColor": "#020617",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.draftduel.app"
    },
    "android": {
      "package": "com.draftduel.app",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-image-picker", "expo-splash-screen"],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
